# Q01: LUBM selective student star
# Primary feature: BGP_JOIN
PREFIX ub: <http://www.lehigh.edu/~zhp2/2004/0401/univ-bench.owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?course ?email ?telephone
WHERE {
    <http://www.Department0.University0.edu/GraduateStudent0>
        rdf:type ub:GraduateStudent ;
        ub:takesCourse ?course ;
        ub:emailAddress ?email ;
        ub:telephone ?telephone .
}
