<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress Corese debug logs -->
    <logger name="fr.inria.corese" level="WARN"/>
    <!-- Suppress RDF4J debug logs -->
    <logger name="org.eclipse.rdf4j" level="WARN"/>
    <!-- Suppress Jena logs (incl. IRI validation warnings from strict 5.x parser) -->
    <logger name="org.apache.jena" level="ERROR"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
